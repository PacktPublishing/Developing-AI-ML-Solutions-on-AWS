{
  "uid": "fraud-incidence",
  "title": "Fraud incidence and caseload",
  "tags": ["fraud"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "Blocked (window)",
      "datasource": { "type": "postgres", "uid": "warehouse" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "red", "value": null }] } }, "overrides": [] },
      "targets": [
        { "refId": "A", "format": "table", "rawSql": "SELECT count(*) AS blocked FROM fraud_decisions WHERE decision = 'block' AND $__timeFilter(event_time)" }
      ]
    },
    {
      "type": "stat",
      "title": "Decisions (window)",
      "datasource": { "type": "postgres", "uid": "warehouse" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "blue" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "format": "table", "rawSql": "SELECT count(*) AS decisions FROM fraud_decisions WHERE $__timeFilter(event_time)" }
      ]
    },
    {
      "type": "stat",
      "title": "Avg fraud score (blocked)",
      "datasource": { "type": "postgres", "uid": "warehouse" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "purple" }, "decimals": 4 }, "overrides": [] },
      "targets": [
        { "refId": "A", "format": "table", "rawSql": "SELECT round(avg(score)::numeric(10,4), 4) AS avg_score FROM fraud_decisions WHERE decision = 'block' AND $__timeFilter(event_time)" }
      ]
    },
    {
      "type": "stat",
      "title": "Analysts needed (peak, 4/hr)",
      "datasource": { "type": "postgres", "uid": "warehouse" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] },
      "targets": [
        { "refId": "A", "format": "table", "rawSql": "SELECT ceil(max(c) / 4.0) AS analysts FROM (SELECT count(*) AS c FROM fraud_decisions WHERE decision = 'block' AND $__timeFilter(event_time) GROUP BY date_trunc('hour', event_time)) h" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Fraud blocks per 5 minutes (the caseload the desk works)",
      "datasource": { "type": "postgres", "uid": "warehouse" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "auto" },
          "color": { "mode": "fixed", "fixedColor": "red" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "transparent", "value": null }, { "color": "orange", "value": 8 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "single" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawSql": "SELECT $__timeGroupAlias(event_time, '5m'), count(*) AS blocks FROM fraud_decisions WHERE decision = 'block' AND $__timeFilter(event_time) GROUP BY 1 ORDER BY 1" }
      ]
    },
    {
      "type": "timeseries",
      "title": "All decisions per 5 minutes, by outcome",
      "datasource": { "type": "postgres", "uid": "warehouse" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 8 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "refId": "A", "format": "time_series", "rawSql": "SELECT $__timeGroupAlias(event_time, '5m'), decision AS metric, count(*) AS n FROM fraud_decisions WHERE $__timeFilter(event_time) GROUP BY 1, decision ORDER BY 1" }
      ]
    }
  ]
}
