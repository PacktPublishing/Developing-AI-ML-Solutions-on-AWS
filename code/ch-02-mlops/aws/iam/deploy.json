{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageChapterRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:TagRole", "iam:UntagRole",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies", "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::*:role/ch02-*"
    },
    {"Sid": "SageMaker", "Effect": "Allow", "Action": "sagemaker:*", "Resource": "*"},
    {"Sid": "SageMakerMlflow", "Effect": "Allow", "Action": ["sagemaker-mlflow:*"], "Resource": "*"},
    {"Sid": "EcrRepository", "Effect": "Allow", "Action": "ecr:*", "Resource": ["arn:aws:ecr:us-east-1:*:repository/ch02-*"]},
    {"Sid": "EcrLogin", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
    {
      "Sid": "CodeBuild",
      "Effect": "Allow",
      "Action": ["codebuild:CreateProject", "codebuild:UpdateProject", "codebuild:DeleteProject", "codebuild:StartBuild", "codebuild:BatchGetBuilds", "codebuild:BatchGetProjects"],
      "Resource": "arn:aws:codebuild:us-east-1:*:project/ch02-*"
    },
    {
      "Sid": "Lambda",
      "Effect": "Allow",
      "Action": ["lambda:CreateFunction", "lambda:DeleteFunction", "lambda:GetFunction", "lambda:UpdateFunctionCode", "lambda:UpdateFunctionConfiguration", "lambda:InvokeFunction", "lambda:AddPermission", "lambda:RemovePermission", "lambda:CreateFunctionUrlConfig", "lambda:GetFunctionUrlConfig", "lambda:DeleteFunctionUrlConfig", "lambda:TagResource"],
      "Resource": "arn:aws:lambda:us-east-1:*:function:ch02-*"
    },
    {"Sid": "Ecs", "Effect": "Allow", "Action": "ecs:*", "Resource": "*"},
    {"Sid": "FargateNetworking", "Effect": "Allow", "Action": ["ec2:Describe*", "ec2:*SecurityGroup*", "ec2:*Tags"], "Resource": "*"},
    {"Sid": "ApiGateway", "Effect": "Allow", "Action": "apigateway:*", "Resource": "arn:aws:apigateway:us-east-1::/*"},
    {"Sid": "ArtifactBuckets", "Effect": "Allow", "Action": "s3:*", "Resource": ["arn:aws:s3:::ch02-*", "arn:aws:s3:::ch02-*/*", "arn:aws:s3:::sagemaker-us-east-1-*", "arn:aws:s3:::sagemaker-us-east-1-*/*"]},
    {"Sid": "Logs", "Effect": "Allow", "Action": "logs:*", "Resource": "arn:aws:logs:us-east-1:*:log-group:*ch02*"}
  ]
}
