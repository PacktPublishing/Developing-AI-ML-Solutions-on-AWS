{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CloudFormation",
      "Effect": "Allow",
      "Action": "cloudformation:*",
      "Resource": [
        "arn:aws:cloudformation:us-east-1:*:stack/ch05-*/*",
        "arn:aws:cloudformation:us-east-1:*:stack/aws-sam-cli-managed-*/*"
      ]
    },
    {
      "Sid": "CloudFormationRead",
      "Effect": "Allow",
      "Action": ["cloudformation:Describe*", "cloudformation:List*", "cloudformation:GetTemplateSummary"],
      "Resource": "*"
    },
    {
      "Sid": "ManageChapterRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole", "iam:DeleteRole", "iam:GetRole", "iam:TagRole", "iam:UntagRole",
        "iam:PutRolePolicy", "iam:DeleteRolePolicy", "iam:GetRolePolicy",
        "iam:AttachRolePolicy", "iam:DetachRolePolicy", "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies", "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::*:role/ch05-*"
    },
    {
      "Sid": "SageMakerPipeline",
      "Effect": "Allow",
      "Action": [
        "sagemaker:CreatePipeline", "sagemaker:UpdatePipeline", "sagemaker:DeletePipeline",
        "sagemaker:DescribePipeline", "sagemaker:StartPipelineExecution",
        "sagemaker:DescribePipelineExecution", "sagemaker:ListPipelineExecutions",
        "sagemaker:ListPipelineExecutionSteps", "sagemaker:CreateProcessingJob",
        "sagemaker:DescribeProcessingJob", "sagemaker:AddTags"
      ],
      "Resource": "arn:aws:sagemaker:us-east-1:*:*/batch-credit-limits*"
    },
    {"Sid": "EcrRepository", "Effect": "Allow", "Action": "ecr:*", "Resource": "arn:aws:ecr:us-east-1:*:repository/ch05-step"},
    {"Sid": "EcrLogin", "Effect": "Allow", "Action": "ecr:GetAuthorizationToken", "Resource": "*"},
    {
      "Sid": "CodeBuild",
      "Effect": "Allow",
      "Action": ["codebuild:CreateProject", "codebuild:UpdateProject", "codebuild:DeleteProject", "codebuild:StartBuild", "codebuild:BatchGetBuilds", "codebuild:BatchGetProjects"],
      "Resource": "arn:aws:codebuild:us-east-1:*:project/ch05-*"
    },
    {
      "Sid": "EventsAndAlerts",
      "Effect": "Allow",
      "Action": [
        "events:PutRule", "events:DeleteRule", "events:DescribeRule", "events:PutTargets", "events:RemoveTargets", "events:TagResource",
        "sns:CreateTopic", "sns:DeleteTopic", "sns:GetTopicAttributes", "sns:SetTopicAttributes", "sns:Subscribe", "sns:TagResource"
      ],
      "Resource": "*"
    },
    {
      "Sid": "RedshiftServerless",
      "Effect": "Allow",
      "Action": "redshift-serverless:*",
      "Resource": "*"
    },
    {
      "Sid": "RedshiftData",
      "Effect": "Allow",
      "Action": ["redshift-data:ExecuteStatement", "redshift-data:DescribeStatement", "redshift-data:GetStatementResult"],
      "Resource": "*"
    },
    {
      "Sid": "Ec2Networking",
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*"
    },
    {
      "Sid": "SecretsManager",
      "Effect": "Allow",
      "Action": ["secretsmanager:CreateSecret", "secretsmanager:DeleteSecret", "secretsmanager:GetSecretValue", "secretsmanager:DescribeSecret", "secretsmanager:TagResource", "secretsmanager:GetRandomPassword"],
      "Resource": "*"
    },
    {"Sid": "ResultsBucket", "Effect": "Allow", "Action": "s3:*", "Resource": ["arn:aws:s3:::ch05-*", "arn:aws:s3:::ch05-*/*", "arn:aws:s3:::aws-sam-cli-managed-*", "arn:aws:s3:::aws-sam-cli-managed-*/*"]},
    {"Sid": "Logs", "Effect": "Allow", "Action": "logs:*", "Resource": "arn:aws:logs:us-east-1:*:log-group:*ch05*"}
  ]
}
